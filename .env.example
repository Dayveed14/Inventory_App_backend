# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inventory

# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts before the user must sign in again (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# Comma-separated frontend URLs allowed to call the API.
# Leave empty during local development to allow all origins.
# Example: CORS_ORIGIN=http://localhost:3000,https://your-frontend.onrender.com
CORS_ORIGIN=

NODE_ENV=development
